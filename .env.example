# Your Claude subscription token, from `make token` (claude setup-token).
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: a Claude API key (`make api-key`). When set it is used instead of the
# subscription token above, and every Claude call is billed to your API account.
ANTHROPIC_API_KEY=
# Your time zone (IANA name, e.g. Europe/London). Day labels and due dates use it.
TZ=UTC

# Database password. Leave this commented out to use the built-in default
# (quizroom-dev). Postgres only reads it when the database volume is first created.
# POSTGRES_PASSWORD=quizroom-dev

# Optional: extra host names Quizroom answers to besides localhost and 127.0.0.1,
# comma-separated, for example behind your own authenticating proxy. Other names
# are refused, so a web page can't reach Quizroom by pointing its domain here.
# ALLOWED_HOSTS=quizroom.example.com
